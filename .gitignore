# ============================================================
# 美研云 · 门店中台 —— Git 忽略规则
# 仅纳入项目源码与部署编排；开发文档 / 报告 / 截图 / 产物 / 二进制一律不入库
# ============================================================

# ---- Java / Maven ----
target/
*.class
*.jar
*.war
.mvn/
mvnw
mvnw.cmd
!**/src/main/**/mvnw
HELP.md

# ---- Node / Frontend（B 端 Vue3）----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/.env.*
!frontend/.env.example
frontend/test-results/
frontend/tmp/
frontend/vite.config.ts.timestamp-*
frontend/component-preview.html
frontend/M1*.md
# 开发期页面验证 / 截图脚本（非项目源码）
frontend/scripts/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 小程序 / uni-app（C 端）----
mp-uniapp/node_modules/
mp-uniapp/dist/
mp-uniapp/unpackage/

# ---- Go 网关 ----
gateway/vendor/
gateway/bin/
gateway/certs/
gateway/meiyun-gateway
gateway/meiyun-gateway-*
gateway/*-go-tmp-umask
gateway/configs/*.local.yaml
*.test
*.out

# ---- IDE / 编辑器 ----
.idea/
*.iml
.vscode/
.swap
*.swp
.project
.classpath
.run/

# ---- Env / 密钥 ----
.env
.env.*
*.pem
*.key
secrets.*
**/application-local.yaml
**/application-local.yml

# ---- OS ----
.DS_Store
Thumbs.db

# ---- 运行日志 ----
logs/
*.log

# ============================================================
# 开发过程产物（非项目代码，不入库）
# ============================================================

# 交付 / 规划 / 进度等开发文档与报告
docs/
design-spec/
*.md
!README.md
CODEBUDDY.md

# 根目录历史草稿 SQL（运行时仅用 backend/db/migration 与 backend/db/seed）
/db/
# 注意：backend/db/ 为运行时迁移与种子脚本，属项目源码，必须入库

# 备份与回收站目录
backup-*/
.trash-*/
.ardot-*/
